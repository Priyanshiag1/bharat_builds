# Vasuli MSME Delayed-Payment Recovery Platform
# Copy this file to .env and fill in the required values.
# NEVER commit your actual .env file.

# AWS Region for deployment
AWS_REGION=ap-south-1

# Optional override for the local environment
# DEMO_MODE=true shrinks wait times for Step Functions (5 days -> 30 seconds)
DEMO_MODE=false

# Optional: Next.js Frontend URL (for local testing API Gateway CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AWS CDK / Backend settings
# Provide appropriate dummy IDs here for setup verification
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=ap-south-1
